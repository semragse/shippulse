{
  "uid": "shippulse-live",
  "title": "ShipPulse — Live Operations",
  "tags": ["shippulse", "live", "vessel-tracking"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"],
    "time_options": ["5m", "15m", "1h", "6h", "24h"]
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Events (last 15 min)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "postgres", "uid": "shippulse-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "shippulse-pg" },
          "rawSql": "SELECT COUNT(*) AS value FROM vessel_positions WHERE ingested_at > now() - interval '15 minutes'",
          "format": "table",
          "rawQuery": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Active vessels (last 5 min)",
      "type": "stat",
      "gridPos": { "x": 5, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "postgres", "uid": "shippulse-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "shippulse-pg" },
          "rawSql": "SELECT COUNT(DISTINCT vessel_id) AS value FROM vessel_positions WHERE ingested_at > now() - interval '5 minutes'",
          "format": "table",
          "rawQuery": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Rejects (last 15 min)",
      "description": "Events rejected by validation. Each also exists on the vessel.positions.rejected Kafka topic.",
      "type": "stat",
      "gridPos": { "x": 10, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "postgres", "uid": "shippulse-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "shippulse-pg" },
          "rawSql": "SELECT COUNT(*) AS value FROM vessel_position_rejects WHERE rejected_at > now() - interval '15 minutes'",
          "format": "table",
          "rawQuery": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 30 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Reject rate %",
      "type": "stat",
      "gridPos": { "x": 15, "y": 0, "w": 5, "h": 4 },
      "datasource": { "type": "postgres", "uid": "shippulse-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "shippulse-pg" },
          "rawSql": "SELECT CASE WHEN (p.c + r.c) = 0 THEN 0 ELSE 100.0 * r.c / (p.c + r.c) END AS value FROM (SELECT COUNT(*) AS c FROM vessel_positions WHERE ingested_at > now() - interval '15 minutes') p, (SELECT COUNT(*) AS c FROM vessel_position_rejects WHERE rejected_at > now() - interval '15 minutes') r",
          "format": "table",
          "rawQuery": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Avg speed (moving vessels)",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "postgres", "uid": "shippulse-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "shippulse-pg" },
          "rawSql": "SELECT COALESCE(AVG(speed_knots), 0) AS value FROM vessel_positions WHERE ingested_at > now() - interval '15 minutes' AND speed_knots > 0.5",
          "format": "table",
          "rawQuery": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "velocityknot",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Live vessel map",
      "description": "Latest known position per vessel. Dots colored by speed class.",
      "type": "geomap",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 12 },
      "datasource": { "type": "postgres", "uid": "shippulse-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "shippulse-pg" },
          "rawSql": "SELECT DISTINCT ON (vessel_id) vessel_id, latitude, longitude, speed_knots, ingested_at FROM vessel_positions WHERE ingested_at > now() - interval '15 minutes' ORDER BY vessel_id, ingested_at DESC",
          "format": "table",
          "rawQuery": true
        }
      ],
      "options": {
        "view": {
          "id": "zero",
          "lat": 52.0,
          "lon": 5.0,
          "zoom": 6
        },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showDebug": false,
          "showMeasure": false,
          "showScale": false,
          "showZoom": true
        },
        "basemap": {
          "type": "osm-standard",
          "name": "Basemap",
          "config": {}
        },
        "layers": [
          {
            "type": "markers",
            "name": "Vessels",
            "config": {
              "style": {
                "size": {
                  "fixed": 8,
                  "min": 2,
                  "max": 15
                },
                "color": {
                  "field": "speed_knots",
                  "fixed": "green"
                },
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "opacity": 1,
                "rotation": {
                  "fixed": 0,
                  "mode": "fixed"
                },
                "symbolAlign": {
                  "horizontal": "center",
                  "vertical": "center"
                }
              },
              "showLegend": true
            },
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "tooltip": true
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "dark-red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 5 },
              { "color": "blue", "value": 15 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Events per minute",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 9 },
      "datasource": { "type": "postgres", "uid": "shippulse-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "shippulse-pg" },
          "rawSql": "SELECT date_trunc('minute', ingested_at) AS time, COUNT(*) AS \"events\" FROM vessel_positions WHERE $__timeFilter(ingested_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "none",
            "showPoints": "auto",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisColorMode": "text",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Rejects by reason (last 15 min)",
      "description": "Distribution of rejection reasons. Shows whether bad data is dominated by parse failures, coordinate errors, speed errors, or missing vessel IDs.",
      "type": "barchart",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 9 },
      "datasource": { "type": "postgres", "uid": "shippulse-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "shippulse-pg" },
          "rawSql": "SELECT reject_reason AS \"reason\", COUNT(*) AS \"count\" FROM vessel_position_rejects WHERE rejected_at > now() - interval '15 minutes' GROUP BY reject_reason ORDER BY count DESC",
          "format": "table",
          "rawQuery": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 200,
        "barRadius": 0,
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "stacking": "none",
        "fillOpacity": 80,
        "gradientMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "text": {
          "valueSize": 12
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "semi-dark-orange" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisColorMode": "text",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Last position per vessel",
      "description": "Latest known position per vessel. Amber/red rows are stale — the pipeline may not be receiving data for that vessel.",
      "type": "table",
      "gridPos": { "x": 0, "y": 25, "w": 24, "h": 9 },
      "datasource": { "type": "postgres", "uid": "shippulse-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "shippulse-pg" },
          "rawSql": "SELECT l.vessel_id, l.latitude, l.longitude, l.speed_knots, l.ingested_at, EXTRACT(EPOCH FROM (now() - l.ingested_at))::int AS seconds_ago FROM (SELECT DISTINCT ON (vessel_id) vessel_id, latitude, longitude, speed_knots, ingested_at FROM vessel_positions ORDER BY vessel_id, ingested_at DESC) l ORDER BY l.vessel_id",
          "format": "table",
          "rawQuery": true
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "vessel_id", "desc": false }],
        "footer": {
          "show": false,
          "reducer": ["sum"],
          "fields": ""
        },
        "frameIndex": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "inspect": false,
            "filterable": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "latitude" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 6 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "longitude" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 6 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "speed_knots" },
            "properties": [
              { "id": "unit", "value": "velocityknot" },
              { "id": "decimals", "value": 1 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "ingested_at" },
            "properties": [
              { "id": "unit", "value": "dateTimeAsIso" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "seconds_ago" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 0 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 60 },
                    { "color": "red", "value": 180 }
                  ]
                }
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              }
            ]
          }
        ]
      }
    }
  ]
}
